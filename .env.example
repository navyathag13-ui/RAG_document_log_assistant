# ─── Application ────────────────────────────────────────────────────────────────
APP_NAME="Engineering RAG Assistant"
DEBUG=false

# ─── Storage ────────────────────────────────────────────────────────────────────
DATA_DIR=data
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=engineering_docs

# ─── Embedding model (downloaded automatically on first run, ~90 MB) ────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ────────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── Retrieval ───────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5

# ─── LLM (optional) ──────────────────────────────────────────────────────────────
# If left blank, /ask returns a retrieval-grounded answer without LLM synthesis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1
