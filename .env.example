# ─── Application ────────────────────────────────────────────────────────────────
APP_NAME="Engineering RAG Assistant"
DEBUG=false

# ─── Storage ────────────────────────────────────────────────────────────────────
DATA_DIR=data
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=engineering_docs

# ─── Embedding model (downloaded automatically on first run, ~90 MB) ────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Chunking ────────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── Retrieval ───────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5

# ─── LLM (optional) ──────────────────────────────────────────────────────────────
# If nothing below is set (neither Azure OpenAI nor plain OpenAI), /ask and
# /agent still work — they return a retrieval-grounded answer without LLM
# synthesis. See app/services/llm_service.py for the exact resolution order.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Azure OpenAI Service (optional, tried before plain OpenAI) ─────────────────
# All three must be set for Azure OpenAI to be used. See README "Azure setup"
# for how to create the resource and deployment (Azure AI Foundry or Portal).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ─── Azure AI Content Safety (optional) ──────────────────────────────────────────
# Both must be set to enable input/output safety screening on /ask and /agent.
# If unset, requests are NOT screened — GET /health reports this explicitly.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_SEVERITY_THRESHOLD=4

# ─── Azure Monitor / Application Insights (optional) ─────────────────────────────
# If unset, telemetry still goes to stdout (as it always has) but nothing is
# shipped to Azure. See README "Deployment" for how to create the resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=
